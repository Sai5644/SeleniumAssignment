package orangepom;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;

public class Recruitment {
   public WebDriver driver;
   public Recruitment(WebDriver driver) {
	   this.driver=driver;
	   PageFactory.initElements(driver,this);
   }
   @FindBy(xpath = "//span[text()=\"Recruitment\"]")
   private WebElement rt;
   @FindBy(xpath = "//a[text()='Vacancies']")
   private WebElement vc;
   @FindBy(xpath = "//button[text()=\" Add \"]")
   private WebElement add;
   @FindBy(xpath = "//label[text()='Vacancy Name']/../following-sibling::div//input[contains(@class,'oxd-input oxd-input--active')]")
   private WebElement vn;
   @FindBy(xpath = "//label[text()='Job Title']/../following-sibling::div//div[contains(@class,'oxd-select-text--after')]")
   private WebElement jt;
   @FindBy(css = "[placeholder=\"Type description here\"]")
   private WebElement dr;
   @FindBy(css = "[placeholder=\"Type for hints...\"]")
   private WebElement hr;
   @FindBy(xpath = "//label[text()='Number of Positions']/../following-sibling::div//input[contains(@class,'oxd-input oxd-input--active')]")
   private WebElement np;
   @FindBy(css = "[type=\"submit\"]")
   private WebElement sv;
   
   public void getrt() {
	   rt.click();
   }
   public void getvc() {
	   vc.click();
   }
   public void getadd() {
	   add.click();
   }
   public void getvn(String value) {
	   vn.sendKeys(value);
   }
   public void getjt() {
		    jt.click();
		    driver.findElement(By.xpath("//div[@role='option']//span[normalize-space()='Automaton Tester']")).click();
		}
   public void getdr(String value) {
	   dr.sendKeys(value);
   }
   public void gethr(String value) {
	   hr.sendKeys(value);
	   driver.findElement(By.xpath("//div[@role='option']//span[text()='A8DCo 4Ys 010Z']")).click();
   }
   public void getnp(String value) {
	   np.sendKeys(value);
   }
   public void getsv() {
	   sv.click();
   }
   
}
